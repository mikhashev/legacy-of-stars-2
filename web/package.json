{
  "name": "legacy-of-stars-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser front-end for Legacy of Stars: the Python engine runs in a Pyodide worker.",
  "scripts": {
    "engine": "node scripts/engine.mjs",
    "typecheck": "tsc --noEmit -p .",
    "dev": "npm run engine && vite",
    "build": "npm run engine && npm run typecheck && vite build",
    "preview": "vite preview",
    "unit": "vitest run",
    "test": "playwright test",
    "test:all": "npm run unit && npm test"
  },
  "dependencies": {
    "preact": "10.29.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/three": "0.185.4",
    "pyodide": "314.0.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
