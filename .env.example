# Legacy of Stars - Environment Variables Template
#
# Copy this file to .env to enable the OPTIONAL AI features.
# The game is fully playable without any of this: alien replies, swan songs
# and the strategic advisor all have written offline versions.

# Which provider from data/llm_providers.json to use (default: "default_provider" in that file).
# Aliases shipped: ollama_local, lm_studio, claude_sonnet, claude_haiku, claude_opus, openai_gpt
# AI_PROVIDER=ollama_local

# Force offline mode (never contact an LLM). Tests set this automatically.
# LOS_OFFLINE=1

# Anthropic Claude API key (for the claude_* aliases) - https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (for the openai_gpt alias) - https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Local models (Ollama, LM Studio) need no key; just run the server and pick the alias.

# Clear the terminal after each generation instead of scrolling (console UI option).
# LOS_CLEAR_SCREEN=1
