# Legacy of Stars - Environment Variables Template
#
# Copy this file to .env and fill in your API keys if you want to use AI features.
# The game works perfectly without any API keys - AI integration is optional.

# Anthropic Claude API (for Claude Sonnet, Haiku, Opus)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (for GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Note: For local AI models (Ollama, LM Studio), no API key is needed.
# Just configure the model settings in data/llm_providers.json
